erDiagram
    User ||--o{ Order : places
    User ||--o{ Review : writes
    User ||--o{ Wishlist : add
    User ||--o{ ShoppingCart : add

    ShoppingCart ||--o| Order : checkout_to
    ShoppingCart ||--|{ CartItem : contains

    Order ||--|{ OrderItem : contains
    PromoCode ||--o{ Order : applied_to

    Product ||--o{ CartItem : added_as
    Product ||--o{ OrderItem : included_in
    Product ||--o{ Review : has
    Product ||--o{ Wishlist : saved_in
    Product ||--o{ BundleItem : included_in

    ProductVariant ||--o{ CartItem : selected_as
    ProductVariant ||--o{ OrderItem : purchased_as

    Bundle ||--|{ BundleItem : contains

    Manufacturer ||--o{ Product : produces

    Distributor ||--o{ Order : fulfills

    Category ||--o{ SubCategory : contains
    SubCategory ||--o{ Product : classifies
    Product ||--o{ ProductVariant : has
    Color ||--o{ ProductVariant : selected_in
    KBSwitch ||--o{ ProductVariant : used_in
    Keycap ||--o{ ProductVariant : used_in

User{
    ObjectId user_id PK
    string username
    string password_hash
    string firstname
    string lastname
    string email
    string phone_number
    string address1 
    string address2 
    string role "customer | admin"
    date created_at 
}

%%user merged with admin

Product{
    ObjectId product_id PK
    string product_name
    string description
    ObjectId category_id FK
    ObjectId subcategory_id FK
    ObjectId manufacturer_id FK

    string connectivity_type
    float bluetooth_version
    
    float price
    float weight
    int stock

    ObjectId manufacturer_id FK
}

Category{
    ObjectId category_id PK
    string category_name "keyboard | mouse | headphone"
}

SubCategory{
    ObjectId subcategory_id PK
    ObjectId category_id FK
    string subcategory_name "mechanical | magnetic | rubber-dome | wired | wireless | headset"
}

Order{
    ObjectId order_id PK
    ObjectId cart_id FK
    int order_number
    string status "pending | paid | shipped | completed"
    ObjectId user_id FK
    int total_quantity
    string payment_method
    string shipping_address
    ObjectId promo_id FK 
    float final_price
    date order_date
    ObjectId distributor_id FK
}

%%order merged with transaction, created orderitem

OrderItem {
  ObjectId orderitem_id PK
  ObjectId order_id FK
  ObjectId product_id FK
  ObjectId variant_id FK
  int quantity
  float unit_price
}

ShoppingCart {
  ObjectId cart_id PK
  ObjectId user_id FK
  string status "active | checked_out"
  date created_at
  date updated_at
}

CartItem {
  ObjectId cart_item_id PK
  ObjectId cart_id FK
  ObjectId product_id FK
  ObjectId variant_id FK
  int quantity
  float unit_price
  date created_at
  date updated_at
}

Wishlist{
    ObjectId wishlist_id PK
    ObjectId product_id FK
    ObjectId user_id FK
}

Review{
    ObjectId review_id PK
    ObjectId user_id FK
    ObjectId product_id FK
    ObjectId orderitem_id FK
    float rating
    string comment
    date review_date
}

Bundle{
    ObjectId bundle_id PK
    string bundlename
    string description
    float bundle_price
    boolean is_active
    int quantity_limit
    ObjectId product_id FK
}

BundleItem {
  ObjectId bundle_item_id PK
  ObjectId bundle_id FK
  ObjectId product_id FK
  int quantity
}

PromoCode{
    ObjectId promo_id PK
    string code
    float min_order_price
    float discount_value
    int max_use
    boolean is_active
    date promo_start
    date expire_at
    string description
    float discount_amount
    ObjectId order_id FK
}

ProductVariant{
    ObjectId variant_id PK
    ObjectId product_id FK
    ObjectId color_id FK

    %%mouse
    int dpi
    string sensor_type
    int button_count

    %%keyboard
    string language
    int key_count
    string keyboard_form
    ObjectId switch_id FK
    ObjectId keycap_id FK

    %%headphone
    string sound_support "stereo | 5.1 | 7.1"
    boolean is_headset
    string freq_range
}

Color{
    ObjectId color_id PK
    string color_name
    ObjectId product_id FK
}

KBSwitch{
    ObjectId switch_id PK
    string switch_name
    ObjectId product_id FK
}

Keycap{
    ObjectId keycap_id PK
    string keycap_name
    ObjectId product_id FK
}

%%added manufacturer and distributor/platforms

Manufacturer{
    ObjectId manufacturer_id PK
    string manufacturer_name
    string manufacturer_location
    ObjectId product_id FK
}

Distributor{
    ObjectId distributor_id PK
    string distributor_name
    string distributor_location
}
